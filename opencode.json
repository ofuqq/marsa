{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/ai/agent-guide.md",
    "docs/ai/architecture-context.md",
    "docs/ai/coding-standards.md"
  ],
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git push --force": "deny",
      "git push --force *": "deny",
      "git push * --force": "deny",
      "git push * --force *": "deny",
      "git push -f": "deny",
      "git push -f *": "deny",
      "git push --force-with-lease": "deny",
      "git push --force-with-lease *": "deny",
      "git push --delete *": "deny",
      "git push * --delete *": "deny",
      "git filter-branch *": "deny",
      "git filter-repo *": "deny",
      "rm -rf .git*": "deny",
      "gh repo *": "deny",
      "gh secret *": "deny",
      "gh variable *": "deny",
      "gh ssh-key *": "deny",
      "gh api *rulesets*": "deny",
      "gh api *protection*": "deny",
      "gh api *settings*": "deny",
      "gh api *webhooks*": "deny",
      "gh api *collaborators*": "deny",
      "gh auth login*": "deny",
      "gh auth logout*": "deny",
      "gh auth refresh*": "deny",
      "gh auth setup-git*": "deny",
      "gh auth token*": "deny"
    }
  }
}
