@page "/login"
@attribute [AllowAnonymous]

<div class="login-view">
    <section class="card" style="max-width: 400px; margin: 3rem auto;" aria-labelledby="login-heading">
        <h1 id="login-heading">Sign In to Marsa</h1>
        <p>Sign in with your local administrator credentials.</p>

        <form method="post" action="/api/v1/auth/login" aria-label="Sign In Form">
            <div style="margin-bottom: 1rem;">
                <label for="username" style="display: block; margin-bottom: 0.5rem;">Username</label>
                <input id="username" name="username" type="text" required autocomplete="username"
                       style="width: 100%; padding: 0.5rem; background: #0f172a; border: 1px solid #334155; color: #fff; border-radius: 4px;" />
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label for="password" style="display: block; margin-bottom: 0.5rem;">Password</label>
                <input id="password" name="password" type="password" required autocomplete="current-password"
                       style="width: 100%; padding: 0.5rem; background: #0f172a; border: 1px solid #334155; color: #fff; border-radius: 4px;" />
            </div>

            <button type="submit"
                    style="width: 100%; padding: 0.75rem; background: #38bdf8; color: #000; font-weight: 600; border: none; border-radius: 4px; cursor: pointer;">
                Sign In
            </button>
        </form>
    </section>
</div>

