<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Marsa — Where your code docks</title>
    <base href="/" />
    <style>
        :root {
            --marsa-bg: #0f172a;
            --marsa-surface: #1e293b;
            --marsa-border: #334155;
            --marsa-text: #f8fafc;
            --marsa-text-muted: #94a3b8;
            --marsa-primary: #38bdf8;
            --marsa-primary-hover: #0284c7;
            --marsa-focus: #f59e0b;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--marsa-bg);
            color: var(--marsa-text);
            line-height: 1.5;
        }
        a:focus-visible, button:focus-visible, input:focus-visible {
            outline: 3px solid var(--marsa-focus);
            outline-offset: 2px;
        }
        .skip-link {
            position: absolute;
            top: -100px;
            inset-inline-start: 1rem;
            background: var(--marsa-primary);
            color: #000;
            padding: 0.5rem 1rem;
            z-index: 1000;
            text-decoration: none;
            font-weight: 600;
            border-radius: 4px;
        }
        .skip-link:focus {
            top: 1rem;
        }
        .app-shell {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        .app-header {
            background-color: var(--marsa-surface);
            border-bottom: 1px solid var(--marsa-border);
            padding: 0.75rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .brand {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--marsa-primary);
            text-decoration: none;
        }
        .nav-list {
            display: flex;
            gap: 1.5rem;
            list-style: none;
            margin: 0;
            padding: 0;
            align-items: center;
        }
        .nav-link {
            color: var(--marsa-text);
            text-decoration: none;
            font-weight: 500;
        }
        .nav-link:hover {
            color: var(--marsa-primary);
        }
        .main-content {
            flex: 1;
            padding: 2rem 1.5rem;
            max-width: 1200px;
            width: 100%;
            margin-inline: auto;
        }
        .app-footer {
            border-top: 1px solid var(--marsa-border);
            padding: 1rem 1.5rem;
            text-align: center;
            color: var(--marsa-text-muted);
            font-size: 0.875rem;
        }
        .badge {
            display: inline-block;
            padding: 0.2rem 0.5rem;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            background-color: var(--marsa-border);
            color: var(--marsa-text);
        }
        .card {
            background-color: var(--marsa-surface);
            border: 1px solid var(--marsa-border);
            border-radius: 8px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>
    <Routes />
</body>
</html>

